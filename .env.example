DATABASE_URL="file:./dev.db"
# Any long random text (at least 32 characters). Changing it signs everyone out.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Office clock for "today", due lists and month totals (IANA name). Default: Asia/Dubai
OFFICE_TIMEZONE="Asia/Dubai"

# Optional: generic lead intake (Zapier / Make) at /api/leads
LEADS_API_KEY="change-me"

# Optional: Facebook / Instagram Lead Ads webhook at /api/leads/meta
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_TOKEN=""

# Optional: read passport photos on the candidate form (photos are sent to Anthropic's API)
ANTHROPIC_API_KEY=""
