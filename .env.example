# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local Postgres...).
# Use the pooled string here on serverless hosts. POSTGRES_PRISMA_URL / POSTGRES_URL (added by Vercel's
# Supabase integration) are used when DATABASE_URL is not set. With none of them, the app runs in demo mode
# on sample data that is not kept.
DATABASE_URL="postgresql://postgres:crm@localhost:5432/crm"
# Optional: direct (non-pooled) string used for migrations when your host gives you two.
# Neon's DATABASE_URL_UNPOOLED and Supabase's POSTGRES_URL_NON_POOLING are also picked up automatically.
# DIRECT_URL=""
# Any long random text (at least 32 characters). Changing it signs everyone out. Required with a database.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# First login, created on deploy only while the database has no users (used by `npm run vercel-build`).
# Not needed locally: `npm run setup` loads demo logins, `npm run setup:empty` creates your own admin.
# ADMIN_EMAIL="you@company.com"
# ADMIN_PASSWORD="a-long-password"
# ADMIN_NAME="Your Name"

# Office clock for "today", due lists and month totals (IANA name). Default: Asia/Dubai
OFFICE_TIMEZONE="Asia/Dubai"

# Optional: generic lead intake (Zapier / Make) at /api/leads
LEADS_API_KEY="change-me"

# Optional: Facebook / Instagram Lead Ads webhook at /api/leads/meta
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_TOKEN=""

# Optional: read passport photos on the candidate form (photos are sent to Anthropic's API)
ANTHROPIC_API_KEY=""
